# Copy to .env.local and fill in. Both values are public and safe in the browser;
# Row Level Security in Supabase decides what they can read and write.
# Never put the service_role (secret) key here or in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Booking emails through Resend (server only: never add NEXT_PUBLIC_ to these).
# Login codes do not use these: Supabase sends them through Resend SMTP set in its dashboard.
RESEND_API_KEY=
# Where new booking requests are emailed.
BOOKING_TEAM_EMAIL=
# Sender on a domain verified in Resend. Empty uses Resend's test sender, which only reaches your own Resend address.
RESEND_FROM=
